{
	# Global options.
	# For production with a real domain, set email and remove auto_https off:
	#   email you@example.com
	auto_https off
	admin off
}

# ─── Dev / single-speaker GCP VM profile ─────────────────────
# Listens on :80 for both http://localhost and the VM's public IP.
# For production (real domain + Let's Encrypt), replace `:80` with the
# domain block — see `Caddyfile.prod` in the PLAYBOOK appendix.
:80 {
	encode zstd gzip

	# Chat + everything FastAPI
	handle /api/* {
		reverse_proxy backend:8000 {
			# SSE: keep the stream open and disable buffering
			flush_interval -1
		}
	}
	handle /health {
		reverse_proxy backend:8000
	}

	# Qdrant dashboard
	# Qdrant's UI expects to be served at the root, so we proxy transparently.
	# For a public VM, wrap this in a `basicauth` block (see Caddyfile.prod).
	handle_path /qdrant/* {
		reverse_proxy qdrant:6333
	}

	# Neo4j Browser
	# Neo4j Browser is a single-page app; strip /neo4j/ prefix and proxy.
	# For a public VM, wrap in basicauth and terminate TLS at Caddy.
	handle_path /neo4j/* {
		reverse_proxy neo4j:7474
	}
	# Neo4j Browser also issues Bolt WS connections directly to :7687 on
	# the origin host — for the iframe to work on a remote VM you'll
	# need to expose 7687 via a firewall rule or use Caddy's WS proxy.

	# Everything else → Next.js
	handle {
		reverse_proxy frontend:3000
	}
}
