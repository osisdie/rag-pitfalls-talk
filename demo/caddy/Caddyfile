{
	auto_https off
	admin off
}

# ─── :80 — auth on parent page + /api/*; iframe-resource paths free ───────────
:80 {
	encode zstd gzip

	handle /health {
		reverse_proxy backend:8000
	}

	@qdrant {
		path /dashboard* /collections* /telemetry /metrics
		path /cluster* /snapshots* /locks /openapi.json /healthz
	}
	handle @qdrant {
		reverse_proxy qdrant:6333
	}

	@neo4j_rest {
		path /db/*
	}
	handle @neo4j_rest {
		reverse_proxy neo4j:7474
	}

	handle /api/* {
		basicauth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
		}
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	handle {
		basicauth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
		}
		reverse_proxy frontend:3000
	}
}

# ─── :8080 — Qdrant dashboard at root (iframe-target, unauth) ─────────────────
# Qdrant + Neo4j set X-Frame-Options:DENY and CSP frame-ancestors 'none' on
# their responses. The browser honours those regardless of what the parent
# page wants, so iframes get blocked. Caddy's top-level `header` directive
# strips them on the way out.
#
# `header` with no matcher applies to every response in the block. `-Name`
# means "delete this header". defer=true so Caddy removes it AFTER the
# reverse-proxied response has been assembled.
:8080 {
	encode zstd gzip
	header {
		-X-Frame-Options
		-Content-Security-Policy
		defer
	}
	reverse_proxy qdrant:6333
}

# ─── :8081 — Neo4j Browser at root (iframe-target, unauth) ────────────────────
:8081 {
	encode zstd gzip
	header {
		-X-Frame-Options
		-Content-Security-Policy
		defer
	}
	reverse_proxy neo4j:7474
}
