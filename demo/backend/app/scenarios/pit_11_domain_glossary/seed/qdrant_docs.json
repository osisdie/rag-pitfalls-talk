[
  {"text": "遞延所得稅負債（Deferred Tax Liability, DTL）指企業因時間差異導致未來需要多繳所得稅的義務。", "source_name": "會計詞典：DTL", "source_url": "https://example.com/glossary/dtl", "source_type": "rule_doc", "canonical_terms": ["遞延所得稅負債", "DTL", "deferred tax liability"]},
  {"text": "遞延收益（Deferred Revenue）指已收款但尚未實現勞務或交付商品時，先列為負債的金額。", "source_name": "會計詞典：遞延收益", "source_url": "https://example.com/glossary/deferred-revenue", "source_type": "rule_doc", "canonical_terms": ["遞延收益", "unearned revenue"]},
  {"text": "遞延費用（Prepaid Expenses）指已支付但尚未認列為費用的金額，常見如預付房租、預付保費。", "source_name": "會計詞典：遞延費用", "source_url": "https://example.com/glossary/prepaid", "source_type": "rule_doc", "canonical_terms": ["遞延費用", "prepaid expenses"]}
]
