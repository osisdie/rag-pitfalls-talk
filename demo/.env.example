# ─── Vertex AI (copy values from repo-root .env) ─────────────
VERTEX_PROJECT_ID=your-gcp-project-id
DEFAULT_VERTEX_AI_LOCATION=us-central1
DEFAULT_VERTEX_AI_MODEL=gemini-2.5-flash-lite
# Absolute path INSIDE the backend container. The host-side .secrets/ dir
# is mounted at /app/.secrets read-only; put your SA JSON there.
GOOGLE_APPLICATION_CREDENTIALS=/app/.secrets/service-account-key.json

# ─── HuggingFace (embedder image downloads model on first boot) ───
# Only needed the first time the embedder pulls BGE-M3. Optional for
# public models but avoids anonymous-rate limits.
HF_TOKEN=

# ─── Neo4j ───────────────────────────────────────────────────
# The live demo VM intentionally uses a publicly-visible password so the
# audience can paste it into the Neo4j Browser; that real value lives in
# docker-compose.yml as the ${NEO4J_PASSWORD:-...} fallback. Override here
# for non-demo deployments.
NEO4J_PASSWORD=changeme

# ─── Runtime knobs (override from defaults if needed) ────────
MEMORY_WINDOW_SIZE=5
RAG_VERSION_CAP=10
CORS_ORIGINS=*
