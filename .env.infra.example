# Copy to .env.infra (gitignored) and fill in.
# Values below mirror the VERTEX_* entries in ./.env; keep them in sync.

# Required
GCP_PROJECT=your-gcp-project-id     # e.g. copy from ./.env VERTEX_PROJECT_ID
GCP_ZONE=us-central1-a              # a zone in the region that matches DEFAULT_VERTEX_AI_LOCATION
VM_NAME=rag-pitfalls-demo
MACHINE_TYPE=e2-standard-4
DISK_SIZE_GB=50
STATIC_IP_NAME=rag-pitfalls-demo-ip

# Optional
SSH_SOURCE_CIDR=0.0.0.0/0          # ← narrow to your-ip/32 after first boot!
REPO_URL=https://github.com/YOUR_ORG/rag-pitfalls-talk
REPO_BRANCH=main
SLACK_WEBHOOK_URL=                  # leave blank to fall back to root .env
